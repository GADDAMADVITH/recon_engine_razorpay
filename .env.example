# ReconEngine environment variables (local development only — never commit real secrets)

# Razorpay Test Mode credentials (read-only integration)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional overrides
# RAZORPAY_BASE_URL=https://api.razorpay.com/v1
# RAZORPAY_TIMEOUT_SECONDS=30

# Frontend (Vite) — public Razorpay Key ID only (never the secret)
VITE_RAZORPAY_KEY_ID=

# Gemini AI explanation (server-side only; never expose to frontend)
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TIMEOUT_SECONDS=45
